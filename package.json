{
  "name": "uzclip-ai",
  "version": "0.1.0",
  "private": true,
  "author": "UzClip AI",
  "desktopName": "UzClip AI",
  "description": "Local-first Uzbek and English video clipper",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron . --dev-server\"",
    "build": "tsc --noEmit && vite build",
    "desktop": "electron .",
    "dist": "npm run build && python worker/build_worker.py && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^6.4.1",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "uz.uzclip.ai",
    "productName": "UzClip AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "worker/dist",
        "to": "worker",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "syncDesktopName": true
    }
  }
}
